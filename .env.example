# Copy to .env for local runs. On Railway set these as service variables. Never commit real values.

# paper = alerts only (Phase 1). Live order placement is not implemented and must stay off.
MODE=paper

# Telegram (create a bot with @BotFather; get your chat id from @userinfobot).
# XAVIER_TELEGRAM_TOKEN / XAVIER_TELEGRAM_CHAT_ID are also accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alpaca market data (free account works: IEX real-time bars, indicative options feed)
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_STOCK_FEED=iex

# Storage. On Railway point these at the mounted volume, e.g. /data
DATA_DIR=./data
DB_PATH=./data/journal.sqlite3
